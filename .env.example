# =================================================================
# MaxxGPT AI Ads Operating System - Environment Configuration
# Copy this file to .env.local and configure your credentials.
# =================================================================

# ----------------- 1. Supabase PostgreSQL & Auth -----------------
# Get these from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ----------------- 2. Meta Marketing API v21.0 -------------------
# Get these from Meta for Developers (developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v21.0
# Optional: Pre-configured System User Token or Agency Access Token (EAAB...)
META_SYSTEM_USER_TOKEN=
META_AD_ACCOUNT_ID=act_123456789

# ----------------- 3. Cloudflare Edge & Turnstile ----------------
# Get these from Cloudflare Dashboard -> Turnstile & API Tokens
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_your_turnstile_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_your_turnstile_secret_key
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# ----------------- 4. Google Sheets Reporting --------------------
# Optional: Google Apps Script Web App URL for 1-click Sheet sync
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your_script_id/exec

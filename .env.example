# =================================================================
# MaxxGPT AI Ads Operating System - Environment Configuration
# =================================================================

# ----------------- Supabase Database & Auth -----------------
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# ----------------- Cloudflare Edge & Turnstile --------------
# Get these from Cloudflare Dashboard -> Turnstile & API Tokens
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAAAx_sample_site_key
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAAAx_sample_secret_key
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id

# ----------------- Meta Marketing API -----------------------
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_GRAPH_API_VERSION=v21.0
